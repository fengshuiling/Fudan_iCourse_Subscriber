# Fudan credentials
STUID=your_student_id
UISPSW=your_password
# Legacy aliases StuId / UISPsw are accepted; do not set conflicting values.

# Course IDs to monitor (comma-separated)
COURSE_IDS=12345,67890

# ModelScope LLM API key
DASHSCOPE_API_KEY=your_dashscope_api_key
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# DASHSCOPE_BASE_URL=
# DEEPSEEK_BASE_URL=
# GEMINI_BASE_URL=
# CRAWL_TERM=  # retained for compatibility; main auto-discovers terms

# QQ SMTP (use authorization code, not login password)
SMTP_EMAIL=your_qq@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
RECEIVER_EMAIL=receiver@example.com

# Storage (optional, defaults shown)
DATA_DIR=data
DB_PATH=data/icourse.db

# SenseVoice model (optional, defaults shown)
SENSEVOICE_MODEL_DIR=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
SILERO_VAD_PATH=silero_vad.onnx

# CircleCI only: set in Project Settings; never commit real values.
# Full checklist and CircleCI model/cache paths: docs/circleci.md
# GH_REPOSITORY=fengshuiling/Fudan_iCourse_Subscriber
# GH_PAT=  # fine-grained PAT: this repo only, Contents read/write
# ICOURSE_ENABLE_RUN=false
# ICOURSE_ENABLE_DATA_WRITE=false
# ICOURSE_MAX_LECTURES=2
